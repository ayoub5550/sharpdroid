new file mode 100644
index 0000000..566c91e
--- /dev/null
+++ b/src/SharpEmu.CLI/EmulatorBench.cs
@@ -0,0 +1,136 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using System.Buffers.Binary;
+using System.Diagnostics;
+using SharpEmu.HLE;
+using SharpEmu.ShaderCompiler;
+using SharpEmu.ShaderCompiler.Vulkan;
+
+namespace SharpEmu.CLI;
+
+// SHARPEMU_BENCH=shader[:iterations[:instructions]] -- a fixed piece of the emulator's own CPU work,
+// timed in-process, for comparing one build of SharpEmu against another on the same machine (an
+// x86-64 build under a translator against a native arm64 one). no guest and no GPU: a synthetic
+// Gen5 compute shader of N ALU instructions is decoded and translated to SPIR-V, which is the work
+// a game's first draw with a new shader puts on the render path.
+internal static class EmulatorBench
+{
+    private const ulong ShaderAddress = 0x1_0000_0000;
+    private const uint SEndpgm = 0xBF810000;
+
+    public static bool TryRun(out int exitCode)
+    {
+        exitCode = 0;
+        var spec = Environment.GetEnvironmentVariable("SHARPEMU_BENCH");
+        if (string.IsNullOrEmpty(spec) || !spec.StartsWith("shader", StringComparison.Ordinal))
+        {
+            return false;
+        }
+
+        var parts = spec.Split(':');
+        var iterations = parts.Length > 1 && int.TryParse(parts[1], out var i) ? i : 50;
+        var length = parts.Length > 2 && int.TryParse(parts[2], out var n) ? n : 2000;
+        var words = BuildProgram(length);
+        var memory = new FlatMemory(ShaderAddress, words.Length * sizeof(uint));
+        var bytes = new byte[words.Length * sizeof(uint)];
+        for (var index = 0; index < words.Length; index++)
+        {
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(index * sizeof(uint)), words[index]);
+        }
+
+        memory.TryWrite(ShaderAddress, bytes);
+        var samples = new double[iterations];
+        var spirvBytes = 0;
+        var total = Stopwatch.StartNew();
+        for (var iteration = 0; iteration < iterations; iteration++)
+        {
+            var clock = Stopwatch.StartNew();
+            var context = new CpuContext(memory, Generation.Gen5);
+            if (!Gen5ShaderTranslator.TryDecodeProgram(context, ShaderAddress, out var program, out var error))
+            {
+                Console.Error.WriteLine($"[BENCH] decode failed: {error}");
+                exitCode = 4;
+                return true;
+            }
+
+            var state = new Gen5ShaderState(program, [], null);
+            var scalars = new uint[256];
+            var evaluation = new Gen5ShaderEvaluation(scalars, scalars, [], []);
+            if (!Gen5SpirvTranslator.TryCompileComputeShader(state, evaluation, 64, 1, 1, out var shader, out error))
+            {
+                Console.Error.WriteLine($"[BENCH] compile failed: {error}");
+                exitCode = 4;
+                return true;
+            }
+
+            spirvBytes = shader.Spirv.Length;
+            samples[iteration] = clock.Elapsed.TotalMilliseconds;
+        }
+
+        var sorted = samples.OrderBy(sample => sample).ToArray();
+        Console.Error.WriteLine(
+            $"[BENCH] shader instructions={length} iterations={iterations} spirv={spirvBytes}B " +
+            $"first={samples[0]:F2}ms median={sorted[sorted.Length / 2]:F2}ms min={sorted[0]:F2}ms " +
+            $"total={total.Elapsed.TotalMilliseconds:F0}ms arch={System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture}");
+        return true;
+    }
+
+    // A dependency chain over v0..v47 of the six f16 VOP2 forms the shader compiler's own tests
+    // decode (v_add/sub/subrev/mul/max/min_f16), so nothing about the program is unusual.
+    private static uint[] BuildProgram(int length)
+    {
+        uint[] ops = [0x32, 0x33, 0x34, 0x35, 0x39, 0x3A];
+        var words = new uint[length + 1];
+        for (var index = 0; index < length; index++)
+        {
+            var op = ops[index % ops.Length];
+            var dst = (uint)((index * 7 + 3) % 48);
+            var src0 = (uint)((index * 5 + 1) % 48);
+            var src1 = (uint)((index * 3 + 2) % 48);
+            words[index] = (op << 25) | (dst << 17) | (src1 << 9) | (256u + src0);
+        }
+
+        words[length] = SEndpgm;
+        return words;
+    }
+
+    private sealed class FlatMemory(ulong baseAddress, int size) : ICpuMemory
+    {
+        private readonly byte[] _storage = new byte[size];
+
+        public bool TryRead(ulong virtualAddress, Span<byte> destination)
+        {
+            if (!TryResolve(virtualAddress, destination.Length, out var offset))
+            {
+                return false;
+            }
+
+            _storage.AsSpan(offset, destination.Length).CopyTo(destination);
+            return true;
+        }
+
+        public bool TryWrite(ulong virtualAddress, ReadOnlySpan<byte> source)
+        {
+            if (!TryResolve(virtualAddress, source.Length, out var offset))
+            {
+                return false;
+            }
+
+            source.CopyTo(_storage.AsSpan(offset, source.Length));
+            return true;
+        }
+
+        private bool TryResolve(ulong address, int length, out int offset)
+        {
+            offset = 0;
+            if (address < baseAddress || address - baseAddress > int.MaxValue)
+            {
+                return false;
+            }
+
+            offset = (int)(address - baseAddress);
+            return offset <= _storage.Length - length;
+        }
+    }
+}
