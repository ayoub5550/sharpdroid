--- a/src/SharpEmu.CLI/Program.cs
+++ b/src/SharpEmu.CLI/Program.cs
@@ -110,6 +110,11 @@ internal static partial class Program
         }
 #endif
 
+        if (SharpEmu.CLI.EmulatorBench.TryRun(out var benchExitCode))
+        {
+            return benchExitCode;
+        }
+
         args = NormalizeInternalArguments(args, out var isMitigatedChild);
 
         if (args.Length == 0)
@@ -188,6 +193,15 @@ internal static partial class Program
             return true;
         }
 
+        // a native linux-arm64 build (sharpdroid's step 0 toward an arm64 SharpEmu) runs everything
+        // up to the first guest instruction and stops there: CpuDispatcher has no backend for it.
+        if (OperatingSystem.IsLinux() && RuntimeInformation.ProcessArchitecture == Architecture.Arm64)
+        {
+            Console.Error.WriteLine(
+                "[LOADER][WARN] native arm64 process: no CPU backend yet, guest execution will be refused.");
+            return true;
+        }
+
         Console.Error.WriteLine(
             $"[LOADER][ERROR] Unsupported process architecture " +
             $"{RuntimeInformation.ProcessArchitecture}: guest code executes " +
diff --git a/src/SharpEmu.Core/Cpu/CpuDispatcher.cs b/src/SharpEmu.Core/Cpu/CpuDispatcher.cs
index 069d348..b1b1cd2 100644
--- a/src/SharpEmu.Core/Cpu/CpuDispatcher.cs
+++ b/src/SharpEmu.Core/Cpu/CpuDispatcher.cs
@@ -272,6 +272,28 @@ public sealed class CpuDispatcher : ICpuDispatcher, IDisposable
                 CpuExitReason.NativeBackendUnavailable);
         }
 
+        // A native arm64 process has no CPU backend yet: DirectExecutionBackend runs guest x86-64
+        // in place and emits x86-64 stubs. Until a translating backend exists (sharpdroid's
+        // docs/native-arm64-backend.md), everything before the first guest instruction runs and
+        // this is where it stops -- the "null backend" of that document's step 0.
+        if (System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture != System.Runtime.InteropServices.Architecture.X64)
+        {
+            LastMilestoneLog = string.Concat(
+                entryFrameDiagnostic,
+                Environment.NewLine,
+                "CpuEngine: none (non-x64 process)");
+            LastNotImplementedInfo = new CpuNotImplementedInfo(
+                CpuNotImplementedSource.NativeBackend,
+                entryPoint,
+                nid: null,
+                exportName: "cpu_backend_unavailable",
+                libraryName: System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture.ToString(),
+                detail: "No CPU backend for a non-x64 process yet.");
+            return FailEarly(
+                OrbisGen2Result.ORBIS_GEN2_ERROR_NOT_IMPLEMENTED,
+                CpuExitReason.NativeBackendUnavailable);
+        }
+
         LastMilestoneLog = string.Concat(
             entryFrameDiagnostic,
             Environment.NewLine,
diff --git a/src/SharpEmu.HLE/Host/HostPlatform.cs b/src/SharpEmu.HLE/Host/HostPlatform.cs
index 30503bb..2ff13d7 100644
--- a/src/SharpEmu.HLE/Host/HostPlatform.cs
+++ b/src/SharpEmu.HLE/Host/HostPlatform.cs
@@ -35,6 +35,15 @@ public static class HostPlatform
             return new PosixHostPlatform();
         }
 
+        // A native linux-arm64 process (sharpdroid's step 0 toward an arm64 SharpEmu): the host
+        // memory, threading, audio and input services are plain POSIX and work as they are. The
+        // CPU dispatcher refuses guest execution there before any x86-64 stub is emitted, and the
+        // emitted-stub symbol resolver is only reached from that backend.
+        if (OperatingSystem.IsLinux() && RuntimeInformation.ProcessArchitecture == Architecture.Arm64)
+        {
+            return new PosixHostPlatform();
+        }
+
         throw new PlatformNotSupportedException(
             "SharpEmu native guest execution requires an x86-64 process on Windows, Linux, or macOS. " +
             "On Apple Silicon, use the osx-x64 build under Rosetta 2.");
diff --git a/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs b/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs
index 442e0ac..232c095 100644
--- a/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs
+++ b/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs
@@ -58,7 +58,7 @@ public sealed partial class ModuleManager
         foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
         {
             var name = assembly.GetName().Name;
-            if (name is null || !IsFrameworkAssembly(name))
+            if (name is null || !IsFrameworkAssembly(name) || SkipOnThisHost(name))
             {
                 continue;
             }
@@ -307,6 +307,16 @@ public sealed partial class ModuleManager
         return (prepared, failed);
     }
 
+    // On a native arm64 Android process the framework's crypto initializers load the OpenSSL shim,
+    // which finds the system's BoringSSL libssl.so, misses a2d_ASN1_OBJECT and aborts the process
+    // (a fail-fast, not an exception). They are left to first use there; SharpEmu's own hashing
+    // (SHA-1 NIDs, SHA-256 SPIR-V digests) needs a bundled OpenSSL 3 or managed hashes on that host
+    // anyway, which is a porting item of its own (docs/native-arm64-backend.md).
+    private static bool SkipOnThisHost(string assemblyName) =>
+        System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture != System.Runtime.InteropServices.Architecture.X64 &&
+        (assemblyName.StartsWith("System.Security.Cryptography", StringComparison.Ordinal) ||
+         assemblyName.StartsWith("System.Net.Security", StringComparison.Ordinal));
+
     // Under SHARPEMU_BOOT_TRACE=1, which initializer threw and why: a type whose .cctor throws here
     // throws TypeInitializationException at every later use, so the list is the triage list.
     private static void ReportThrow(Assembly assembly, string type, Exception ex)
