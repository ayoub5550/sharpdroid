diff --git a/src/SharpEmu.HLE/BootTrace.cs b/src/SharpEmu.HLE/BootTrace.cs
new file mode 100644
index 0000000..4210197
--- /dev/null
+++ b/src/SharpEmu.HLE/BootTrace.cs
@@ -0,0 +1,40 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using System.Diagnostics;
+
+namespace SharpEmu.HLE;
+
+/// <summary>
+/// Opt-in boot phase timing (SHARPEMU_BOOT_TRACE=1). Each mark prints the system uptime, so a
+/// line can be lined up with a timestamp taken outside the process (a launcher, a bench script),
+/// plus the milliseconds since the first mark. Off by default and free when off.
+/// </summary>
+public static class BootTrace
+{
+    public static readonly bool Enabled =
+        Environment.GetEnvironmentVariable("SHARPEMU_BOOT_TRACE") == "1";
+
+    private static readonly Stopwatch Clock = Stopwatch.StartNew();
+
+    public static void Mark(string phase)
+    {
+        if (!Enabled)
+        {
+            return;
+        }
+
+        var uptime = "?";
+        try
+        {
+            var text = File.ReadAllText("/proc/uptime");
+            var space = text.IndexOf(' ');
+            uptime = space > 0 ? text[..space] : text.Trim();
+        }
+        catch
+        {
+        }
+
+        Console.Error.WriteLine($"[BOOT] uptime={uptime} t={Clock.Elapsed.TotalMilliseconds:F0}ms {phase}");
+    }
+}
diff --git a/src/SharpEmu.HLE/ModuleManager.cs b/src/SharpEmu.HLE/ModuleManager.cs
index 3025c84..0cb5aa0 100644
--- a/src/SharpEmu.HLE/ModuleManager.cs
+++ b/src/SharpEmu.HLE/ModuleManager.cs
@@ -69,8 +69,15 @@ public sealed class ModuleManager : IModuleManager
             _warmupAssemblies.CopyTo(assemblies);
         }
 
+        BootTrace.Mark("warm-start");
         assemblies = WithGuestReachableDependencies(assemblies);
+        BootTrace.Mark("warm-dependencies-resolved");
         var bclWarmed = WarmFrameworkTypeInitializers();
+        BootTrace.Mark("warm-framework-cctors");
+        var cctorTicks = 0L;
+        var prepareTicks = 0L;
+        var reflectTicks = 0L;
+        var phase = System.Diagnostics.Stopwatch.StartNew();
 
         var warmed = 0;
         var failed = 0;
@@ -79,6 +86,7 @@ public sealed class ModuleManager : IModuleManager
         foreach (var assembly in assemblies)
         {
             Type[] types;
+            phase.Restart();
             try
             {
                 types = assembly.GetTypes();
@@ -87,6 +95,7 @@ public sealed class ModuleManager : IModuleManager
             {
                 types = ex.Types.Where(t => t is not null).ToArray()!;
             }
+            reflectTicks += phase.ElapsedTicks;
 
             const BindingFlags allMembers = BindingFlags.Public | BindingFlags.NonPublic |
                 BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;
@@ -98,6 +107,7 @@ public sealed class ModuleManager : IModuleManager
                     continue;
                 }
 
+                phase.Restart();
                 try
                 {
                     RuntimeHelpers.RunClassConstructor(type.TypeHandle);
@@ -108,6 +118,8 @@ public sealed class ModuleManager : IModuleManager
                     // A throw here beats a guest-thread fail-fast later; swallow and continue.
                     failed++;
                 }
+                cctorTicks += phase.ElapsedTicks;
+                phase.Restart();
 
                 // Force-JIT (not execute) every method so no guest thread compiles one first.
                 MethodBase[] members;
@@ -121,6 +133,8 @@ public sealed class ModuleManager : IModuleManager
                 {
                     continue;
                 }
+                reflectTicks += phase.ElapsedTicks;
+                phase.Restart();
 
                 foreach (var member in members)
                 {
@@ -139,9 +153,16 @@ public sealed class ModuleManager : IModuleManager
                         jitFailed++;
                     }
                 }
+                prepareTicks += phase.ElapsedTicks;
             }
         }
 
+        if (BootTrace.Enabled)
+        {
+            double Ms(long ticks) => ticks * 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+            BootTrace.Mark($"warm-hle reflect={Ms(reflectTicks):F0}ms cctors={Ms(cctorTicks):F0}ms prepare={Ms(prepareTicks):F0}ms");
+        }
+
         Console.Error.WriteLine(
             $"[HLE] Warmed {warmed} type initializers ({failed} threw) + JIT-compiled {jitted} methods ({jitFailed} skipped) across {assemblies.Length} HLE assemblies, plus {bclWarmed} framework type initializers.");
     }
