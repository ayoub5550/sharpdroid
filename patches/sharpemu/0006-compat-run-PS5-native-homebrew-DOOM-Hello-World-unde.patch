diff --git a/src/SharpEmu.Core/Loader/ImportLibraryBindings.cs b/src/SharpEmu.Core/Loader/ImportLibraryBindings.cs
new file mode 100644
index 0000000..08682b3
--- /dev/null
+++ b/src/SharpEmu.Core/Loader/ImportLibraryBindings.cs
@@ -0,0 +1,179 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using System.Buffers.Binary;
+using System.Collections.Concurrent;
+using System.Text;
+
+namespace SharpEmu.Core.Loader;
+
+/// <summary>
+/// Which library each NID was imported from (by the main image) and exported under (by loaded
+/// sce_module PRXs). Symbol names carry it as "NID#L#M": L is the library id, looked up in the
+/// DT_SCE_IMPORT_LIB / DT_SCE_EXPORT_LIB tables.
+///
+/// The LLE redirect sends an import to a loaded module's export of the same NID. That is right
+/// for a retail game, whose eboot imports malloc from "libc" and whose sce_module/libc.prx exports
+/// it under "libc". It is wrong when the eboot imports the NID from a *system* library (for
+/// example libSceLibcInternal) and a bundled PRX happens to export the same NID under another
+/// library: on the console the system library answers. Homebrew built on the clean-room libc.prx
+/// shim hits exactly this (its "libc" exports of malloc/free are placeholders returning 0).
+/// </summary>
+public static class ImportLibraryBindings
+{
+    private const long DtSceExportLib = 0x61000013;
+    private const long DtSceImportLib = 0x61000015;
+    private const long DtSceExportLibNext = 0x61000047;
+    private const long DtSceImportLibNext = 0x61000049;
+    private const string NidAlphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-";
+
+    private static readonly ConcurrentDictionary<string, HashSet<string>> MainImports = new(StringComparer.Ordinal);
+    private static readonly ConcurrentDictionary<string, HashSet<string>> ModuleExports = new(StringComparer.Ordinal);
+    private static readonly bool Disabled =
+        string.Equals(Environment.GetEnvironmentVariable("SHARPEMU_IGNORE_IMPORT_LIBRARY"), "1", StringComparison.Ordinal);
+
+    [ThreadStatic]
+    internal static bool CurrentIsMain;
+
+    public static void Reset()
+    {
+        MainImports.Clear();
+        ModuleExports.Clear();
+    }
+
+    /// <summary>
+    /// True when the main image imports <paramref name="nid"/> only from libraries that no loaded
+    /// module exports it under, so the import must not be redirected to that module.
+    /// </summary>
+    public static bool IsLibraryMismatch(string nid)
+    {
+        if (Disabled ||
+            !MainImports.TryGetValue(nid, out var imported) ||
+            !ModuleExports.TryGetValue(nid, out var exported))
+        {
+            return false;
+        }
+
+        lock (imported)
+        lock (exported)
+        {
+            return !imported.Overlaps(exported);
+        }
+    }
+
+    internal static void Record(
+        ReadOnlySpan<byte> dynamicTable,
+        ReadOnlySpan<byte> stringTable,
+        ReadOnlySpan<byte> symbolTable,
+        bool isMainImage)
+    {
+        if (dynamicTable.IsEmpty || stringTable.IsEmpty || symbolTable.IsEmpty)
+        {
+            return;
+        }
+
+        var libraries = ReadLibraries(dynamicTable, stringTable, isMainImage);
+        if (libraries.Count == 0)
+        {
+            return;
+        }
+
+        var target = isMainImage ? MainImports : ModuleExports;
+        const int symbolSize = 24;
+        for (var offset = 0; offset + symbolSize <= symbolTable.Length; offset += symbolSize)
+        {
+            var nameOffset = BinaryPrimitives.ReadUInt32LittleEndian(symbolTable.Slice(offset, 4));
+            var sectionIndex = BinaryPrimitives.ReadUInt16LittleEndian(symbolTable.Slice(offset + 6, 2));
+            var defined = sectionIndex != 0;
+            // Imports are the undefined symbols of the main image; exports the defined ones of a module.
+            if (nameOffset == 0 || defined == isMainImage || nameOffset >= stringTable.Length)
+            {
+                continue;
+            }
+
+            var slice = stringTable[(int)nameOffset..];
+            var end = slice.IndexOf((byte)0);
+            if (end <= 0)
+            {
+                continue;
+            }
+
+            var name = Encoding.ASCII.GetString(slice[..end]);
+            var parts = name.Split('#');
+            if (parts.Length < 3 || parts[0].Length == 0 || !TryDecodeId(parts[1], out var libraryId) ||
+                !libraries.TryGetValue(libraryId, out var libraryName))
+            {
+                continue;
+            }
+
+            var set = target.GetOrAdd(parts[0], static _ => new HashSet<string>(StringComparer.Ordinal));
+            lock (set)
+            {
+                set.Add(libraryName);
+            }
+        }
+    }
+
+    private static Dictionary<int, string> ReadLibraries(
+        ReadOnlySpan<byte> dynamicTable,
+        ReadOnlySpan<byte> stringTable,
+        bool imports)
+    {
+        var libraries = new Dictionary<int, string>();
+        for (var offset = 0; offset + 16 <= dynamicTable.Length; offset += 16)
+        {
+            var tag = BinaryPrimitives.ReadInt64LittleEndian(dynamicTable.Slice(offset, 8));
+            var value = BinaryPrimitives.ReadUInt64LittleEndian(dynamicTable.Slice(offset + 8, 8));
+            if (tag == 0)
+            {
+                break;
+            }
+
+            var wanted = imports
+                ? tag is DtSceImportLib or DtSceImportLibNext
+                : tag is DtSceExportLib or DtSceExportLibNext;
+            if (!wanted)
+            {
+                continue;
+            }
+
+            var nameOffset = (uint)value;
+            var id = (int)(value >> 48);
+            if (nameOffset >= stringTable.Length)
+            {
+                continue;
+            }
+
+            var slice = stringTable[(int)nameOffset..];
+            var end = slice.IndexOf((byte)0);
+            if (end > 0)
+            {
+                libraries[id] = Encoding.ASCII.GetString(slice[..end]);
+            }
+        }
+
+        return libraries;
+    }
+
+    private static bool TryDecodeId(string text, out int id)
+    {
+        id = 0;
+        if (text.Length == 0 || text.Length > 3)
+        {
+            return false;
+        }
+
+        foreach (var c in text)
+        {
+            var digit = NidAlphabet.IndexOf(c);
+            if (digit < 0)
+            {
+                return false;
+            }
+
+            id = id * 64 + digit;
+        }
+
+        return true;
+    }
+}
