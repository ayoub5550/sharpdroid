+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+namespace SharpEmu.HLE;
+
+/// <summary>
+/// Host allocations the guest addresses directly but the guest memory map does not track: the
+/// HLE libc heap (malloc/calloc/realloc served from host memory). Guest memory reads and writes
+/// that find no guest region consult this, so HLE functions (fread into a malloc'd buffer,
+/// snprintf into one) work on heap pointers the way the guest's own loads and stores already do.
+/// </summary>
+public static class HostHeapRanges
+{
+    /// <summary>Returns true when [address, address + length) lies inside one live host heap block.</summary>
+    public static Func<ulong, ulong, bool>? Contains { get; set; }
+
+    public static bool IsHostHeap(ulong address, ulong length) =>
+        length != 0 && Contains is { } contains && contains(address, length);
+}
diff --git a/src/SharpEmu.Libs/Kernel/KernelLibcHomebrewExports.cs b/src/SharpEmu.Libs/Kernel/KernelLibcHomebrewExports.cs
new file mode 100644
index 0000000..6c6d106
--- /dev/null
+++ b/src/SharpEmu.Libs/Kernel/KernelLibcHomebrewExports.cs
@@ -0,0 +1,262 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using SharpEmu.HLE;
+
+namespace SharpEmu.Libs.Kernel;
+
+/// <summary>
+/// libc entry points that retail titles get from their bundled libc.prx but homebrew built
+/// against the public PS5 payload SDK imports from the system (libSceLibcInternal): found
+/// missing by running DOOM (doomgeneric) as a native PS5 app.
+/// </summary>
+public static class KernelLibcHomebrewExports
+{
+    [SysAbiExport(
+        Nid = "pXvbDfchu6k",
+        ExportName = "strncasecmp",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libc")]
+    public static int Strncasecmp(CpuContext ctx)
+    {
+        var left = ctx[CpuRegister.Rdi];
+        var right = ctx[CpuRegister.Rsi];
+        var limit = ctx[CpuRegister.Rdx];
+        if (limit == 0 || left == right)
+        {
+            ctx[CpuRegister.Rax] = 0;
+            return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+        }
+
+        if (left == 0 || right == 0)
+        {
+            ctx[CpuRegister.Rax] = 1;
+            return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+        }
+
+        Span<byte> a = stackalloc byte[1];
+        Span<byte> b = stackalloc byte[1];
+        for (ulong i = 0; i < limit; i++)
+        {
+            if (!KernelMemoryCompatExports.TryReadCompat(ctx, left + i, a) ||
+                !KernelMemoryCompatExports.TryReadCompat(ctx, right + i, b))
+            {
+                ctx[CpuRegister.Rax] = 1;
+                return (int)OrbisGen2Result.ORBIS_GEN2_ERROR_MEMORY_FAULT;
+            }
+
+            var ca = ToLower(a[0]);
+            var cb = ToLower(b[0]);
+            if (ca != cb || ca == 0)
+            {
+                ctx[CpuRegister.Rax] = unchecked((ulong)(long)(ca - cb));
+                return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+            }
+        }
+
+        ctx[CpuRegister.Rax] = 0;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
+
+    [SysAbiExport(
+        Nid = "YQ0navp+YIc",
+        ExportName = "puts",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libc")]
+    public static int Puts(CpuContext ctx)
+    {
+        var address = ctx[CpuRegister.Rdi];
+        if (address == 0 || !KernelMemoryCompatExports.TryReadNullTerminatedUtf8(ctx, address, 64 * 1024, out var text))
+        {
+            ctx[CpuRegister.Rax] = unchecked((ulong)(-1L));
+            return (int)OrbisGen2Result.ORBIS_GEN2_ERROR_MEMORY_FAULT;
+        }
+
+        Console.Out.WriteLine(text);
+        Console.Out.Flush();
+        ctx[CpuRegister.Rax] = 1;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
+
+    [SysAbiExport(
+        Nid = "tLB5+4TEOK0",
+        ExportName = "putc",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libc")]
+    public static int Putc(CpuContext ctx) => SharpEmu.Libs.LibcStdio.LibcStdioExports.Fputc(ctx);
+
+    [SysAbiExport(
+        Nid = "m5wN+SwZOR4",
+        ExportName = "putchar",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libc")]
+    public static int Putchar(CpuContext ctx)
+    {
+        var character = unchecked((byte)ctx[CpuRegister.Rdi]);
+        Console.Out.Write((char)character);
+        ctx[CpuRegister.Rax] = character;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
+
+    /// <summary>mkdir(path, mode): created under the host directory the guest path maps to.</summary>
+    [SysAbiExport(
+        Nid = "JGMio+21L4c",
+        ExportName = "mkdir",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libKernel")]
+    public static int Mkdir(CpuContext ctx)
+    {
+        var address = ctx[CpuRegister.Rdi];
+        if (address == 0 || !KernelMemoryCompatExports.TryReadNullTerminatedUtf8(ctx, address, 4096, out var guestPath) ||
+            string.IsNullOrEmpty(guestPath) || KernelMemoryCompatExports.IsReadOnlyGuestMutationPath(guestPath))
+        {
+            ctx[CpuRegister.Rax] = unchecked((ulong)(-1L));
+            return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+        }
+
+        var hostPath = KernelMemoryCompatExports.ResolveGuestPath(guestPath);
+        try
+        {
+            if (!string.IsNullOrEmpty(hostPath))
+            {
+                Directory.CreateDirectory(hostPath);
+                ctx[CpuRegister.Rax] = 0;
+                return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+            }
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
+        {
+        }
+
