@@ -0,0 +1,51 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using SharpEmu.HLE;
+using System.Text;
+
+namespace SharpEmu.Libs.Kernel;
+
+/// <summary>
+/// sceKernelSendNotificationRequest: the system toast. Homebrew uses it to report progress and
+/// failures (often as its only output), so the text is written to the log and the call succeeds.
+/// Request layout (0xC30 bytes): ten int32 header fields, one int32, one byte flag, then
+/// message[1024] at 0x2D.
+/// </summary>
+public static class KernelNotificationExports
+{
+    private const ulong MessageOffset = 0x2D;
+    private const int MessageMax = 1024;
+
+    [SysAbiExport(
+        Nid = "zl7hupSO0C0",
+        ExportName = "sceKernelSendNotificationRequest",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libKernel")]
+    public static int KernelSendNotificationRequest(CpuContext ctx)
+    {
+        var request = ctx[CpuRegister.Rsi];
+        var size = ctx[CpuRegister.Rdx];
+        var text = string.Empty;
+        if (request != 0 && size > MessageOffset)
+        {
+            var max = (int)Math.Min((ulong)MessageMax, size - MessageOffset);
+            var buffer = new byte[max];
+            var length = 0;
+            for (; length < max; length++)
+            {
+                if (!ctx.Memory.TryRead(request + MessageOffset + (ulong)length, buffer.AsSpan(length, 1)) ||
+                    buffer[length] == 0)
+                {
+                    break;
+                }
+            }
+
+            text = Encoding.UTF8.GetString(buffer, 0, length);
+        }
+
+        Console.Error.WriteLine($"[KERNEL][NOTIFY] {text}");
+        ctx[CpuRegister.Rax] = 0;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
+}
