diff --git a/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs b/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs
new file mode 100644
index 0000000..442e0ac
--- /dev/null
+++ b/src/SharpEmu.HLE/ModuleManager.LeanWarmup.cs
@@ -0,0 +1,407 @@
+// Copyright (C) 2026 SharpEmu Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+using System.Reflection;
+using System.Reflection.Metadata;
+using System.Reflection.Metadata.Ecma335;
+using System.Runtime.CompilerServices;
+
+namespace SharpEmu.HLE;
+
+// The same guarantee as the legacy warm-up -- every class constructor of an HLE or framework type
+// has run, and every non-generic HLE method has been prepared, before any guest thread exists --
+// at a fraction of its cost, because the work list comes from metadata instead of reflection.
+//
+// * Reflection's GetTypes() loads every type of an assembly and GetConstructors()/GetMethods()
+//   materialise a MethodInfo per method. A boot under FEX spends seconds on that alone. A metadata
+//   token is all RunClassConstructor and PrepareMethod need, and reading tokens loads nothing.
+// * Only types that have something to initialise -- a .cctor, or static fields whose storage the
+//   runtime allocates on first access -- are touched for their initializer. RunClassConstructor on
+//   any other type is a no-op beyond loading it, and type loads already happen on guest threads
+//   (every generic instantiation is loaded lazily), so skipping them changes nothing.
+// * Class constructors still run one at a time, in metadata order, framework first: the same order
+//   the legacy sweep used, so initialisation-order behaviour cannot change. Preparing methods
+//   executes no code, so that part is spread over several threads.
+//
+// SHARPEMU_WARMUP=legacy restores the reflection sweep; SHARPEMU_WARMUP_THREADS=N sets the number of
+// threads that prepare methods (1 = all on the calling thread).
+public sealed partial class ModuleManager
+{
+    internal enum WarmupMode
+    {
+        Lean,
+        Legacy,
+    }
+
+    internal static WarmupMode SelectedWarmupMode =>
+        string.Equals(Environment.GetEnvironmentVariable("SHARPEMU_WARMUP"), "legacy", StringComparison.OrdinalIgnoreCase)
+            ? WarmupMode.Legacy
+            : WarmupMode.Lean;
+
+    internal static int WarmupThreads()
+    {
+        if (int.TryParse(Environment.GetEnvironmentVariable("SHARPEMU_WARMUP_THREADS"), out var requested) && requested >= 1)
+        {
+            return Math.Min(requested, 64);
+        }
+
+        return Math.Clamp(Environment.ProcessorCount - 1, 1, 6);
+    }
+
+    private readonly record struct WarmPlan(Assembly Assembly, int[] InitTypes, int[] Methods);
+
+    private static void WarmLean(Assembly[] hleAssemblies)
+    {
+        // Framework class constructors first, as the legacy sweep did (no methods: the BCL is
+        // ReadyToRun-compiled and far too large to prepare).
+        var frameworkInitialised = 0;
+        foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
+        {
+            var name = assembly.GetName().Name;
+            if (name is null || !IsFrameworkAssembly(name))
+            {
+                continue;
+            }
+
+            if (TryPlan(assembly, includeMethods: false, out var frameworkPlan))
+            {
+                frameworkInitialised += RunInitializers(frameworkPlan, out _);
+            }
+            else
+            {
+                frameworkInitialised += WarmAssemblyByReflection(assembly, includeMethods: false, out _, out _, out _, report: false);
+            }
+        }
+
+        BootTrace.Mark("warm-framework-cctors");
+
+        var plans = new List<WarmPlan>(hleAssemblies.Length);
+        var warmed = 0;
+        var failed = 0;
+        var jitted = 0;
+        var jitFailed = 0;
+        // NativeAOT has no JIT: every method is already machine code, so only the class
+        // constructors are left to warm (and reflecting over methods would only cost time).
+        var includeMethods = RuntimeFeature.IsDynamicCodeCompiled;
+        foreach (var assembly in hleAssemblies)
+        {
+            if (TryPlan(assembly, includeMethods, out var plan))
+            {
+                warmed += RunInitializers(plan, out var threw);
+                failed += threw;
+                plans.Add(plan);
+            }
+            else
+            {
+                warmed += WarmAssemblyByReflection(assembly, includeMethods, out var threw, out var prepared, out var prepareFailed);
+                failed += threw;
+                jitted += prepared;
+                jitFailed += prepareFailed;
+            }
+        }
+
+        if (BootTrace.Enabled)
+        {
+            Console.Error.WriteLine($"[HLE] warm-up assemblies: {string.Join(", ", hleAssemblies.Select(a => a.GetName().Name))}");
+        }
+
+        BootTrace.Mark("warm-hle-cctors");
+
+        var threads = WarmupThreads();
+        var (preparedCount, prepareFailures) = PrepareMethods(plans, threads);
+        jitted += preparedCount;
+        jitFailed += prepareFailures;
+
+        BootTrace.Mark("warm-hle-prepare");
+        var mode = RuntimeFeature.IsDynamicCodeCompiled ? $"lean warm-up, {threads} thread(s)" : "lean warm-up, NativeAOT";
+        Console.Error.WriteLine(
+            $"[HLE] Warmed {warmed} type initializers ({failed} threw) + JIT-compiled {jitted} methods ({jitFailed} skipped) across {hleAssemblies.Length} HLE assemblies, plus {frameworkInitialised} framework type initializers ({mode}).");
+    }
+
+    // The work list of one assembly, from its metadata. False when the runtime will not hand out
+    // the metadata (the caller falls back to reflection for that assembly).
+    private static unsafe bool TryPlan(Assembly assembly, bool includeMethods, out WarmPlan plan)
+    {
+        plan = default;
+        byte* blob;
+        int length;
+        try
+        {
+            if (!assembly.TryGetRawMetadata(out blob, out length))
+            {
+                return false;
+            }
+        }
+        catch
+        {
+            return false;
+        }
+
+        var reader = new MetadataReader(blob, length);
+        var initTypes = new List<int>();
+        var methods = includeMethods ? new List<int>() : null;
+        foreach (var typeHandle in reader.TypeDefinitions)
+        {
+            // Row 1 is <Module>, which GetTypes() never returned.
+            if (MetadataTokens.GetRowNumber(typeHandle) == 1)
+            {
+                continue;
+            }
+
+            var type = reader.GetTypeDefinition(typeHandle);
+
+            // Type.ContainsGenericParameters for a definition: a nested type of a generic type
+            // redeclares its parent's parameters, so this covers those too.
+            if (type.GetGenericParameters().Count > 0)
+            {
+                continue;
+            }
+
+            var needsInit = false;
+            foreach (var methodHandle in type.GetMethods())
+            {
+                var method = reader.GetMethodDefinition(methodHandle);
+                if (!needsInit && reader.StringComparer.Equals(method.Name, ".cctor"))
+                {
+                    needsInit = true;
+                }
+
+                if (methods is null ||
+                    (method.Attributes & MethodAttributes.Abstract) != 0 ||
+                    (method.ImplAttributes & MethodImplAttributes.InternalCall) != 0 ||
+                    method.GetGenericParameters().Count > 0)
+                {
+                    continue;
+                }
+
+                methods.Add(MetadataTokens.GetToken(methodHandle));
+            }
+
+            if (!needsInit)
+            {
+                foreach (var fieldHandle in type.GetFields())
+                {
+                    var attributes = reader.GetFieldDefinition(fieldHandle).Attributes;
+                    if ((attributes & (FieldAttributes.Static | FieldAttributes.Literal)) == FieldAttributes.Static)
+                    {
+                        needsInit = true;
+                        break;
+                    }
+                }
+            }
+
+            if (needsInit)
+            {
+                initTypes.Add(MetadataTokens.GetToken(typeHandle));
+            }
+        }
+
+        plan = new WarmPlan(assembly, initTypes.ToArray(), methods?.ToArray() ?? Array.Empty<int>());
+        return true;
+    }
+
+    private static int RunInitializers(in WarmPlan plan, out int failed)
+    {
+        failed = 0;
+        var warmed = 0;
+        var module = plan.Assembly.ManifestModule.ModuleHandle;
+        foreach (var token in plan.InitTypes)
+        {
+            try
+            {
+                RuntimeHelpers.RunClassConstructor(module.ResolveTypeHandle(token));
+                warmed++;
+            }
+            catch (Exception ex)
+            {
+                // A throw here beats a guest-thread fail-fast later; swallow and continue.
+                failed++;
+                ReportThrow(plan.Assembly, $"0x{token:X8}", ex);
+            }
+        }
+
+        return warmed;
+    }
+
+    private static (int Prepared, int Failed) PrepareMethods(List<WarmPlan> plans, int threads)
+    {
+        var total = 0;
+        foreach (var plan in plans)
+        {
+            total += plan.Methods.Length;
+        }
+
+        var modules = new ModuleHandle[total];
+        var tokens = new int[total];
+        var next = 0;
+        foreach (var plan in plans)
+        {
+            var module = plan.Assembly.ManifestModule.ModuleHandle;
+            foreach (var token in plan.Methods)
+            {
+                modules[next] = module;
+                tokens[next] = token;
+                next++;
+            }
+        }
+
+        var prepared = 0;
+        var failed = 0;
+        var cursor = 0;
+        const int Chunk = 64;
+
+        void Drain()
+        {
+            var localPrepared = 0;
+            var localFailed = 0;
+            while (true)
+            {
+                var start = Interlocked.Add(ref cursor, Chunk) - Chunk;
+                if (start >= total)
+                {
+                    break;
+                }
+
+                var end = Math.Min(start + Chunk, total);
+                for (var i = start; i < end; i++)
+                {
+                    try
+                    {
+                        RuntimeHelpers.PrepareMethod(modules[i].ResolveMethodHandle(tokens[i]));
+                        localPrepared++;
+                    }
+                    catch
+                    {
+                        localFailed++;
+                    }
+                }
+            }
+
+            Interlocked.Add(ref prepared, localPrepared);
+            Interlocked.Add(ref failed, localFailed);
+        }
+
+        if (threads <= 1 || total < Chunk * 2)
+        {
+            Drain();
+            return (prepared, failed);
+        }
+
+        var workers = new Thread[threads - 1];
+        for (var i = 0; i < workers.Length; i++)
+        {
+            workers[i] = new Thread(Drain, maxStackSize: 1024 * 1024)
+            {
+                IsBackground = true,
+                Name = $"hle-warmup-{i + 1}",
+            };
+            workers[i].Start();
+        }
+
+        Drain();
+        foreach (var worker in workers)
+        {
+            worker.Join();
+        }
+
+        return (prepared, failed);
+    }
+
+    // Under SHARPEMU_BOOT_TRACE=1, which initializer threw and why: a type whose .cctor throws here
+    // throws TypeInitializationException at every later use, so the list is the triage list.
+    private static void ReportThrow(Assembly assembly, string type, Exception ex)
+    {
+        if (!BootTrace.Enabled)
+        {
+            return;
+        }
+
+        var root = ex is TypeInitializationException { InnerException: { } inner } ? inner : ex;
+        Console.Error.WriteLine($"[HLE] cctor threw: {assembly.GetName().Name}!{type}: {root.GetType().Name}: {root.Message}");
+    }
+
+    // The legacy per-assembly sweep, for an assembly whose metadata the runtime will not expose.
+    private static int WarmAssemblyByReflection(Assembly assembly, bool includeMethods, out int failed, out int prepared, out int prepareFailed, bool report = true)
+    {
+        failed = 0;
+        prepared = 0;
+        prepareFailed = 0;
+        var warmed = 0;
+        Type[] types;
+        try
+        {
+            types = assembly.GetTypes();
+        }
+        catch (ReflectionTypeLoadException ex)
+        {
+            types = ex.Types.Where(t => t is not null).ToArray()!;
+        }
+        catch
+        {
+            return 0;
+        }
+
+        const BindingFlags allMembers = BindingFlags.Public | BindingFlags.NonPublic |
+            BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;
+
+        foreach (var type in types)
+        {
+            if (type is null || type.ContainsGenericParameters)
+            {
+                continue;
+            }
+
+            try
+            {
+                RuntimeHelpers.RunClassConstructor(type.TypeHandle);
+                warmed++;
+            }
+            catch (Exception ex)
+            {
+                failed++;
+                // framework types throw here by the hundred under NativeAOT ("missing native code"):
+                // their statics were preinitialised at compile time or are never touched, so only
+                // the HLE side is worth naming.
+                if (report)
+                {
+                    ReportThrow(assembly, type.FullName ?? type.Name, ex);
+                }
+            }
+
+            if (!includeMethods)
+            {
+                continue;
+            }
+
+            MethodBase[] members;
+            try
+            {
+                members = type.GetConstructors(allMembers).Concat<MethodBase>(type.GetMethods(allMembers)).ToArray();
+            }
+            catch
+            {
+                continue;
+            }
+
+            foreach (var member in members)
+            {
+                if (member.ContainsGenericParameters || member.IsAbstract || member.MethodImplementationFlags.HasFlag(MethodImplAttributes.InternalCall))
+                {
+                    continue;
+                }
+
+                try
+                {
+                    RuntimeHelpers.PrepareMethod(member.MethodHandle);
+                    prepared++;
+                }
+                catch
+                {
+                    prepareFailed++;
+                }
+            }
+        }
+
+        return warmed;
+    }
+}
