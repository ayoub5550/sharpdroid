<Project Sdk="Microsoft.NET.Sdk">
  <!-- the FexCpuBackend proof of concept (docs/native-arm64-backend.md, section 4). one program,
       published twice: linux-bionic-arm64 runs guest.bin through libsharpfex (FEXCore in-process,
       guest code only), linux-x64 runs it natively the way SharpEmu does today: under the host
       layer on a phone, where FEX translates the whole process. build.sh drives both. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <DirectPInvoke Include="libc" />
  </ItemGroup>
</Project>
