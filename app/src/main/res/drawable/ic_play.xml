<?xml version="1.0" encoding="utf-8"?>
<!--
  a play arrow, for the button that starts a run.

  Material Symbols' own filled play, so it is the glyph every other app's play button is rather than a
  triangle of ours that is nearly it. the icons this app draws by hand are the ones with no such
  counterpart.

  tinted from the theme, so it follows light and dark without a second copy. that is the role the plus
  on the managers' button takes too, since it is the same button.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="?attr/colorOnSurfaceVariant">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M320,760L320,200L760,480L320,760Z" />

</vector>
