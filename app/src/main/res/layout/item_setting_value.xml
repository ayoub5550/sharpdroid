<?xml version="1.0" encoding="utf-8"?>
<!--
  a row that opens a single-choice dialog.

  the chosen entry is drawn on its own line at the bottom rather than as the subtitle: the
  explanation is what the row says when it has nothing else to say, and the value is the thing
  somebody came back to check.

  **the button under it is drawn only on a per-game list, and only on a row that overrides the global
  value.** on the global list the way back to a default is a long press with nothing on screen saying
  so, because a mark distinguishing a set row from an untouched one has to hold its width on every row
  to annotate one of them. a per-game list inverts that: an overridden row is the interesting case
  rather than the rare one, so it is worth the space, and it is only ever a few rows wide. see
  SettingsAdapter, which is what decides whether it appears.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- **a glyph before the text, drawn only for a row that names one**: the four controller ports,
         as Eden draws a controller beside each of its players. 30dp, between Eden's 24dp, which reads
         as small beside two lines of text, and Material's 40dp for what leads a two-line item, which
         turns a glyph into a toy: 28dp still reads small, and 32dp already leans toward the toy. its
         edge sits on the 20dp line the heading and every other row's text start on. the row tints it,
         so it carries no colour here. -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary" />

        <!-- **a filled button, which is the shape the game list's own empty state uses to offer the
             one thing worth doing there.** a text button was the first version and it reads as
             another line of the row rather than as a control: the row above it is already three
             lines of text, one of them accented, so a fourth accented line is the wrong difference
             to draw. filled, it is unmistakably a thing to press, and its own edge is what lines up
             with the text column rather than a label pulled out from under its padding. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/useGlobal"
            style="@style/Widget.SharpDroid.Button.UseGlobal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setting_use_global"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
