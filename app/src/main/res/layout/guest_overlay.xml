<?xml version="1.0" encoding="utf-8"?>
<!--
  the panel the back button opens over a running game.

  **it is mostly the log**, and the two things around it are a header naming it with the actions that
  belong to it, and the actions that belong to the run. what the panel does not carry is the game's
  name or its artwork: both are on the scene that opens from the game's cover and on the screen the
  launch draws while it boots, and a third statement of them would cost this width and add nothing.

  **it is inflated rather than built in code**, which is possible because the panel takes its scheme
  from a themed context rather than from the window - this activity wears the framework fullscreen
  theme and has no colour roles to offer. see GuestOverlay, which inflates this against that context.

  **the empty place is deliberate and holds no disabled control.** a second icon goes into `header`,
  left of Copy. a button that is present and does nothing is a bug report; a place to put one is not.

  **android:tint and never app:tint, for every icon in this window.** app:tint is read by
  AppCompatImageView, and the inflater that swaps a plain view for that one belongs to
  AppCompatActivity, which the activity a guest renders into is not. MaterialButton is named in full
  here and so is constructed as itself, which is why app:icon and app:iconTint below are read - the
  attribute is the button's own rather than one a swapped-in view would have supplied.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/overlay_log"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <!--
          an icon button rather than a labelled one: the header is a title and its actions, and a word
          beside each of them would push the title out of a panel this narrow. the tooltip and the
          content description are where the action is named, and both are the same string.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/overlay_log_copy"
            android:tooltipText="@string/overlay_log_copy"
            app:icon="@drawable/ic_copy"
            app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!--
      **the fill is colorSurfaceContainer on the panel's colorSurface**, which is the pairing every
      list in the app has: the panel is a screen's worth of background and this is the one thing
      raised off it. the four container roles above and below that one are deliberately not used -
      the scheme that ships as the default names neither, so anything reaching for one gets Material's
      own baseline grey against a background that is not it.

      no stroke, because the fill already separates it and an outline here would be a second edge
      inside a panel that has one.
    -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/overlay_log_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp">

        <!--
          **a button rather than a card.** the settings scene's section button with one line taken
          out looks like a row somebody might open, where this is the one way out of a run and the
          only thing on the panel that changes what the device is doing. the filled style is the
          accent's, and the accent is named by every scheme here where the tonal and outlined styles
          reach for roles two of them leave to Material's baseline.
        -->
        <!--
          pausing and resuming, above leaving: the one of the two that is taken back. filled like Exit
          game for the same reason Exit game is - the accent is the role every scheme names - and its
          label and icon say what a tap does now, so they swap while the game is paused. GuestOverlay
          sets both.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_pause"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_exit"
            app:icon="@drawable/ic_exit_to_app"
            app:iconGravity="textStart" />

    </LinearLayout>

</LinearLayout>
