<?xml version="1.0" encoding="utf-8"?>
<!--
  a boolean row.

  **the switch is centred on the text and the button hangs below both**, which is why this is a column
  holding a row rather than one row of three things. a switch centred against the whole cell slides
  down the moment a button appears under the title, so the control moves as a value is overridden -
  and on a list of switches that reads as the row shifting rather than as the row gaining something.

  **a title with no summary under it is centred on the switch, and a title over one is not.** the
  switch's view is 48dp tall, its touch target, so a title alone at the top would sit above the
  switch's middle; a title over a summary is centred by its box but not by its ink, and sits lower
  than the switch looks. the adapter sets which, row by row, since the layout cannot ask whether the
  summary is shown.

  the button is item_setting_value.xml's, and that file says when it is drawn and why.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/useGlobal"
        style="@style/Widget.SharpDroid.Button.UseGlobal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/setting_use_global"
        android:visibility="gone" />

</LinearLayout>
